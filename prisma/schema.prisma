generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUNO
  MOTORISTA
  SUPERVISOR
}

enum StatusCadastro {
  PENDENTE
  APROVADO
  REJEITADO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

enum StatusReserva {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
  EMBARCADO
  DESEMBARCADO
}

enum StatusViagem {
  PENDENTE
  INICIADA
  FINALIZADA
  CANCELADA
}

model User {
  id                      String               @id @default(uuid())
  nome                    String
  email                   String               @unique
  senha                   String
  role                    Role                 @default(ALUNO)
  statusCadastro          StatusCadastro       @default(PENDENTE)
  matricula               String?
  cpf                     String?
  rg                      String?
  telefone                String?
  comprovanteMatriculaUrl String?
  instituicaoId           Int? // <- FK para Instituição
  instituicao             Instituicao?         @relation(fields: [instituicaoId], references: [id])
  motorista               Motorista?
  supervisor              Supervisor?
  diasSolicitados         DiasSolicitados[]
  reservas                Reserva[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Instituicao {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  cidade String?
  alunos User[]

  @@map("instituicoes")
}

model Motorista {
  userId   String    @id
  cnh      String
  telefone String?
  user     User      @relation(fields: [userId], references: [id])
  veiculos Veiculo[]
  viagens  Viagem[]

  @@map("motoristas")
}

model Supervisor {
  userId       String @id
  departamento String
  user         User   @relation(fields: [userId], references: [id])

  @@map("supervisores")
}

model Veiculo {
  id          Int       @id @default(autoincrement())
  placa       String    @unique
  modelo      String
  motoristaId String
  motorista   Motorista @relation(fields: [motoristaId], references: [userId])

  @@map("veiculos")
}

model DiasSolicitados {
  id     Int       @id @default(autoincrement())
  userId String
  dia    DiaSemana
  user   User      @relation(fields: [userId], references: [id])

  @@map("dias_solicitados")
}

model Reserva {
  id       Int           @id @default(autoincrement())
  userId   String
  status   StatusReserva @default(PENDENTE)
  data     DateTime
  user     User          @relation(fields: [userId], references: [id])
  viagemId Int?
  viagem   Viagem?       @relation(fields: [viagemId], references: [id])

  @@map("reservas")
}

model Viagem {
  id          Int          @id @default(autoincrement())
  motoristaId String
  data        DateTime
  status      StatusViagem @default(PENDENTE)
  motorista   Motorista    @relation(fields: [motoristaId], references: [userId])
  reservas    Reserva[]

  @@map("viagens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}
